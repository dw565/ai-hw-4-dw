# Copy to .env and fill in. Never commit .env.
# Portkey key used for the agent's OpenAI-compatible model calls.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: signs login sessions so they survive server restarts.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional: override the chat model (default gpt-5.6-luna).
# CHAT_MODEL=gpt-5.6-luna
